# ============================================================
# VẠN ĐẠO TRƯỜNG SINH - Git Ignore
# ============================================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/

# Production build outputs
dist/
*/dist/
*/*/dist/
dist-packaged/
*/dist-packaged/
*/*/dist-packaged/

# Environment files
.env
.env.*
!.env.example
server/.env
client/.env

# Logs and runtime artifacts
*.log
logs/
*/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & local persistent caches
backups/
*.sqlite
*.sqlite3
*.db
prisma/dev.db

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Temporary work & scratch
scratch/
__pycache__/
*.pyc
*.private.json

# Long intermediate recordings; the reviewed runtime-demo.mp4 is committed.
docs/evidence/*/video/
